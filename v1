--------------------------------------------------
-- VALID TARGET
--------------------------------------------------

local function IsValidTarget(Character)

    local ok, Name =
        pcall(function()
            return Character.Name
        end)

    if not ok then
        return false
    end

    if type(Name) ~= "string" then
        return false
    end

    if string.sub(
        Name,
        1,
        1
    ) == "." then
        return false
    end

    if LocalPlayer
        and Name == LocalPlayer.Name
    then
        return false
    end

    return true
end

--------------------------------------------------
-- CHARACTER NAME
--------------------------------------------------

local function GetCharacterName(Character)

    local Humanoid =
        Character:FindFirstChild(
            "Humanoid"
        )

    if not Humanoid then
        return nil
    end

    local ok, Value =
        pcall(function()

            return Humanoid:GetAttribute(
                "CharacterName"
            )
        end)

    if not ok then
        return nil
    end

    if type(Value) ~= "string"
        or Value == ""
    then
        return nil
    end

    return Value
end

--------------------------------------------------
-- LEVEL
--------------------------------------------------

local function GetLevel(Character)

    local ok, Value =
        pcall(function()

            return Character:GetAttribute(
                "Level"
            )
        end)

    if not ok
        or Value == nil
    then
        return nil
    end

    local Number =
        tonumber(Value)

    if not Number then
        return nil
    end

    return math.floor(Number)
end

--------------------------------------------------
-- DISTANCE
--------------------------------------------------

local function GetDistance(Character)

    if not LocalPlayer then
        return nil
    end

    local LocalCharacter =
        Live:FindFirstChild(
            LocalPlayer.Name
        )

    if not LocalCharacter then
        return nil
    end

    local LocalRoot =
        LocalCharacter:FindFirstChild(
            "HumanoidRootPart"
        )

    local TargetRoot =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not LocalRoot
        or not TargetRoot
    then
        return nil
    end

    local ok, Result =
        pcall(function()

            local A =
                LocalRoot.Position

            local B =
                TargetRoot.Position

            local dx =
                B.X - A.X

            local dy =
                B.Y - A.Y

            local dz =
                B.Z - A.Z

            return math.sqrt(
                dx * dx
                + dy * dy
                + dz * dz
            )
        end)

    if not ok then
        return nil
    end

    return Result
end

--------------------------------------------------
-- HEALTH
--------------------------------------------------

local function GetHealth(Character)

    local Humanoid =
        Character:FindFirstChild(
            "Humanoid"
        )

    if not Humanoid then
        return nil
    end

    local HealthOK, Health =
        pcall(function()
            return Humanoid.Health
        end)

    local MaxOK, MaxHealth =
        pcall(function()
            return Humanoid.MaxHealth
        end)

    if not HealthOK
        or not MaxOK
    then
        return nil
    end

    if type(Health) ~= "number"
        or type(MaxHealth) ~= "number"
        or MaxHealth <= 0
    then
        return nil
    end

    local Ratio =
        math.max(
            0,
            math.min(
                1,
                Health / MaxHealth
            )
        )

    local Percent =
        math.floor(
            Ratio * 100
            + 0.5
        )

    return {
        Health = Health,
        MaxHealth = MaxHealth,
        Ratio = Ratio,
        Percent = Percent
    }
end

--------------------------------------------------
-- COMBAT TAG
--------------------------------------------------

local function GetCombatTag(Character)

    local Humanoid =
        Character:FindFirstChild(
            "Humanoid"
        )

    if not Humanoid then
        return 0
    end

    local ok, Value =
        pcall(function()

            return Humanoid:GetAttribute(
                "DangerCounter"
            )
        end)

    if not ok
        or Value == nil
    then
        return 0
    end

    local Number =
        tonumber(Value)

    if not Number then
        return 0
    end

    return math.max(
        0,
        math.floor(Number)
    )
end

--------------------------------------------------
-- SAFE REMOVE
--------------------------------------------------

local function SafeRemove(Object)

    if not Object then
        return
    end

    pcall(function()
        Object:Remove()
    end)
end

--------------------------------------------------
-- HIDE HP BAR
--------------------------------------------------

local function HideHealthBar(Data)

    Data.Outline.Visible =
        false

    Data.Background.Visible =
        false

    Data.Fill.Visible =
        false

    for _, Line
        in ipairs(
            Data.Dividers
        )
    do
        Line.Visible = false
    end
end

--------------------------------------------------
-- HIDE BOX
--------------------------------------------------

local function HideBox(Data)

    for _, Line
        in ipairs(
            Data.BoxLines
        )
    do
        Line.Visible = false
    end
end

--------------------------------------------------
-- HIDE EVERYTHING
--------------------------------------------------

local function HideESP(Data)

    Data.NameText.Visible =
        false

    Data.InfoText.Visible =
        false

    Data.CombatText.Visible =
        false

    HideHealthBar(Data)

    HideBox(Data)
end

--------------------------------------------------
-- CREATE PLAYER ESP
--------------------------------------------------

local function CreateESP(Character)

    if ESP[Character] then
        return
    end

    if not IsValidTarget(
        Character
    ) then
        return
    end

    local Head =
        Character:FindFirstChild(
            "Head"
        )

    local Torso =
        Character:FindFirstChild(
            "Torso"
        )

    if not Head
        or not Torso
    then
        return
    end

    local Health =
        GetHealth(Character)

    if not Health then
        return
    end

    --------------------------------------------------
    -- NAME / LEVEL
    --------------------------------------------------

    local NameText =
        Drawing.new("Text")

    NameText.Text = ""
    NameText.Size = TEXT_SIZE
    NameText.Center = true
    NameText.Outline = true
    NameText.Color = TEXT_COLOR
    NameText.Visible = false

    --------------------------------------------------
    -- DISTANCE / HP %
    --------------------------------------------------

    local InfoText =
        Drawing.new("Text")

    InfoText.Text = ""
    InfoText.Size = TEXT_SIZE
    InfoText.Center = true
    InfoText.Outline = true
    InfoText.Color = TEXT_COLOR
    InfoText.Visible = false

    --------------------------------------------------
    -- COMBAT TAG
    --------------------------------------------------

    local CombatText =
        Drawing.new("Text")

    CombatText.Text = ""
    CombatText.Size = TEXT_SIZE
    CombatText.Center = true
    CombatText.Outline = true
    CombatText.Color = TEXT_COLOR
    CombatText.Visible = false

    --------------------------------------------------
    -- HP BAR
    --------------------------------------------------

    local Outline =
        Drawing.new("Square")

    Outline.Filled = true
    Outline.Color = BLACK
    Outline.Visible = false

    local Background =
        Drawing.new("Square")

    Background.Filled = true
    Background.Color = EMPTY_COLOR
    Background.Visible = false

    local Fill =
        Drawing.new("Square")

    Fill.Filled = true
    Fill.Color = BAR_COLOR
    Fill.Visible = false

    --------------------------------------------------
    -- HP DIVIDERS
    --------------------------------------------------

    local Dividers = {}

    for i = 1, 4 do

        local Line =
            Drawing.new("Line")

        Line.Color =
            BLACK

        Line.Thickness =
            1

        Line.Visible =
            false

        Dividers[i] =
            Line
    end

    --------------------------------------------------
    -- BOX
    --------------------------------------------------

    local BoxLines = {}

    for i = 1, 4 do

        local Line =
            Drawing.new("Line")

        Line.Color =
            BOX_COLOR

        Line.Thickness =
            1

        Line.Visible =
            false

        BoxLines[i] =
            Line
    end

    --------------------------------------------------
    -- STORE
    --------------------------------------------------

    ESP[Character] = {

        NameText =
            NameText,

        InfoText =
            InfoText,

        CombatText =
            CombatText,

        Outline =
            Outline,

        Background =
            Background,

        Fill =
            Fill,

        Dividers =
            Dividers,

        BoxLines =
            BoxLines
    }
end

--------------------------------------------------
-- UPDATE PLAYER ESP
--------------------------------------------------

local function UpdateESP(Character)

    local Data =
        ESP[Character]

    if not Data then
        CreateESP(Character)
        return
    end

    --------------------------------------------------
    -- MASTER
    --------------------------------------------------

    if not Settings.MasterESP then
        HideESP(Data)
        return
    end

    if not IsValidTarget(Character) then
        HideESP(Data)
        return
    end

    --------------------------------------------------
    -- PARTS
    --------------------------------------------------

    local Head =
        Character:FindFirstChild(
            "Head"
        )

    local Torso =
        Character:FindFirstChild(
            "Torso"
        )

    local LeftLeg =
        Character:FindFirstChild(
            "Left Leg"
        )

    local RightLeg =
        Character:FindFirstChild(
            "Right Leg"
        )

    if not Head
        or not Torso
    then
        HideESP(Data)
        return
    end

    --------------------------------------------------
    -- VALUES
    --------------------------------------------------

    local CharacterName =
        GetCharacterName(Character)

    local Level =
        GetLevel(Character)

    local Health =
        GetHealth(Character)

    local Distance =
        GetDistance(Character)

    local CombatTags =
        GetCombatTag(Character)

    if not Health
        or not Distance
    then
        HideESP(Data)
        return
    end

    --------------------------------------------------
    -- TEXT POSITION
    --------------------------------------------------

    local TextOK,
        TextScreen,
        TextVisible =
        pcall(function()

            return Camera:WorldToScreenPoint(

                Head.Position
                + TEXT_WORLD_OFFSET
            )
        end)

    if TextOK
        and TextScreen
        and TextVisible
    then

        local CurrentLine = 0

        --------------------------------------------------
        -- NAME + LEVEL
        --------------------------------------------------

        local NameParts = {}

        if Settings.Name
            and CharacterName
        then

            table.insert(
                NameParts,
                CharacterName
            )
        end

        if Settings.Level
            and Level
        then

            table.insert(
                NameParts,
                "["
                .. tostring(Level)
                .. "]"
            )
        end

        if #NameParts > 0 then

            Data.NameText.Text =
                table.concat(
                    NameParts,
                    " "
                )

            Data.NameText.Position =
                Vector2.new(

                    TextScreen.X,

                    TextScreen.Y
                    + (
                        TEXT_LINE_HEIGHT
                        * CurrentLine
                    )
                )

            Data.NameText.Visible =
                true

            CurrentLine =
                CurrentLine + 1

        else

            Data.NameText.Visible =
                false
        end

        --------------------------------------------------
        -- DISTANCE + HP %
        --------------------------------------------------

        local InfoParts = {}

        if Settings.Distance then

            local RoundedDistance =
                math.floor(
                    Distance + 0.5
                )

            table.insert(
                InfoParts,

                tostring(
                    RoundedDistance
                )
                .. " Studs"
            )
        end

        if Settings.HealthPercent then

            table.insert(
                InfoParts,

                "["
                .. tostring(
                    Health.Percent
                )
                .. "%]"
            )
        end

        if #InfoParts > 0 then

            Data.InfoText.Text =
                table.concat(
                    InfoParts,
                    " "
                )

            Data.InfoText.Position =
                Vector2.new(

                    TextScreen.X,

                    TextScreen.Y
                    + (
                        TEXT_LINE_HEIGHT
                        * CurrentLine
                    )
                )

            Data.InfoText.Visible =
                true

            CurrentLine =
                CurrentLine + 1

        else

            Data.InfoText.Visible =
                false
        end

        --------------------------------------------------
        -- COMBAT TAG
        --------------------------------------------------

        if Settings.CombatTag
            and CombatTags > 0
        then

            Data.CombatText.Text =
                "CTAG: "
                .. tostring(
                    CombatTags
                )

            Data.CombatText.Position =
                Vector2.new(

                    TextScreen.X,

                    TextScreen.Y
                    + (
                        TEXT_LINE_HEIGHT
                        * CurrentLine
                    )
                )

            Data.CombatText.Visible =
                true

        else

            Data.CombatText.Visible =
                false
        end

    else

        Data.NameText.Visible =
            false

        Data.InfoText.Visible =
            false

        Data.CombatText.Visible =
            false
    end

    --------------------------------------------------
    -- BODY SCREEN POSITIONS
    --------------------------------------------------

    local TorsoOK,
        TorsoScreen,
        TorsoVisible =
        pcall(function()

            return Camera:WorldToScreenPoint(
                Torso.Position
            )
        end)

    if not TorsoOK
        or not TorsoScreen
        or not TorsoVisible
    then

        HideHealthBar(Data)
        HideBox(Data)

        return
    end

    local HeadOK,
        HeadScreen =
        pcall(function()

            return Camera:WorldToScreenPoint(

                Head.Position
                + Vector3.new(
                    0,
                    1,
                    0
                )
            )
        end)

    if not HeadOK
        or not HeadScreen
    then

        HideHealthBar(Data)
        HideBox(Data)

        return
    end

    local BottomPart =
        LeftLeg
        or RightLeg
        or Torso

    local BottomOK,
        BottomScreen =
        pcall(function()

            return Camera:WorldToScreenPoint(

                BottomPart.Position
                - Vector3.new(
                    0,
                    1,
                    0
                )
            )
        end)

    if not BottomOK
        or not BottomScreen
    then

        HideHealthBar(Data)
        HideBox(Data)

        return
    end

    --------------------------------------------------
    -- BODY HEIGHT
    --------------------------------------------------

    local BodyHeight =
        math.abs(

            BottomScreen.Y
            - HeadScreen.Y
        )

    --------------------------------------------------
    -- BOUNDING BOX
    --------------------------------------------------

    if Settings.BoundingBox
        and Distance
        <= MAX_DETAIL_DISTANCE
    then

        local Top =
            math.min(
                HeadScreen.Y,
                BottomScreen.Y
            )

        local Bottom =
            math.max(
                HeadScreen.Y,
                BottomScreen.Y
            )

        local CenterY =
            (
                Top
                + Bottom
            ) / 2

        local BoxHeight =
            BodyHeight
            * BOX_HEIGHT_SCALE

        local BoxWidth =
            BodyHeight
            * BOX_WIDTH_SCALE

        local BoxTop =
            CenterY
            - (BoxHeight / 2)

        local BoxBottom =
            CenterY
            + (BoxHeight / 2)

        local BoxLeft =
            TorsoScreen.X
            - (BoxWidth / 2)

        local BoxRight =
            TorsoScreen.X
            + (BoxWidth / 2)

        --------------------------------------------------
        -- TOP
        --------------------------------------------------

        Data.BoxLines[1].From =
            Vector2.new(
                BoxLeft,
                BoxTop
            )

        Data.BoxLines[1].To =
            Vector2.new(
                BoxRight,
                BoxTop
            )

        --------------------------------------------------
        -- BOTTOM
        --------------------------------------------------

        Data.BoxLines[2].From =
            Vector2.new(
                BoxLeft,
                BoxBottom
            )

        Data.BoxLines[2].To =
            Vector2.new(
                BoxRight,
                BoxBottom
            )

        --------------------------------------------------
        -- LEFT
        --------------------------------------------------

        Data.BoxLines[3].From =
            Vector2.new(
                BoxLeft,
                BoxTop
            )

        Data.BoxLines[3].To =
            Vector2.new(
                BoxLeft,
                BoxBottom
            )

        --------------------------------------------------
        -- RIGHT
        --------------------------------------------------

        Data.BoxLines[4].From =
            Vector2.new(
                BoxRight,
                BoxTop
            )

        Data.BoxLines[4].To =
            Vector2.new(
                BoxRight,
                BoxBottom
            )

        for _, Line
            in ipairs(
                Data.BoxLines
            )
        do
            Line.Visible = true
        end

    else

        HideBox(Data)
    end

    --------------------------------------------------
    -- HEALTH BAR RANGE
    --------------------------------------------------

    if not Settings.HealthBar
        or Distance
        > MAX_DETAIL_DISTANCE
    then

        HideHealthBar(Data)

        return
    end

    --------------------------------------------------
    -- BAR SIZE
    --------------------------------------------------

    local BarHeight =
        BodyHeight
        * HEIGHT_MULTIPLIER

    BarHeight =
        math.max(

            MIN_BAR_HEIGHT,

            math.min(

                MAX_BAR_HEIGHT,

                BarHeight
            )
        )

    local ScaledWidth =
        math.max(

            MIN_BAR_WIDTH,

            math.min(

                BAR_WIDTH,

                BarHeight
                * WIDTH_SCALE
            )
        )

    local ScaledOffset =
        math.min(

            BAR_X_OFFSET,

            BarHeight
            * OFFSET_SCALE
        )

    --------------------------------------------------
    -- BAR POSITION
    --------------------------------------------------

    local BarX =
        TorsoScreen.X
        - ScaledOffset

    local BarY =
        TorsoScreen.Y
        - (BarHeight / 2)

    --------------------------------------------------
    -- BLACK OUTLINE
    --------------------------------------------------

    Data.Outline.Position =
        Vector2.new(

            BarX
            - OUTLINE_SIZE,

            BarY
            - OUTLINE_SIZE
        )

    Data.Outline.Size =
        Vector2.new(

            ScaledWidth
            + (
                OUTLINE_SIZE
                * 2
            ),

            BarHeight
            + (
                OUTLINE_SIZE
                * 2
            )
        )

    Data.Outline.Visible =
        true

    --------------------------------------------------
    -- EMPTY BACKGROUND
    --------------------------------------------------

    Data.Background.Position =
        Vector2.new(
            BarX,
            BarY
        )

    Data.Background.Size =
        Vector2.new(

            ScaledWidth,

            BarHeight
        )

    Data.Background.Visible =
        true

    --------------------------------------------------
    -- INNER AREA
    --------------------------------------------------

    local InnerWidth =
        math.max(

            1,

            ScaledWidth
            - (
                INNER_PADDING
                * 2
            )
        )

    local InnerHeight =
        math.max(

            1,

            BarHeight
            - (
                INNER_PADDING
                * 2
            )
        )

    --------------------------------------------------
    -- HP FILL
    --------------------------------------------------

    local FillHeight =
        InnerHeight
        * Health.Ratio

    local FillX =
        BarX
        + INNER_PADDING

    local FillY =
        BarY
        + BarHeight
        - INNER_PADDING
        - FillHeight

    Data.Fill.Position =
        Vector2.new(
            FillX,
            FillY
        )

    Data.Fill.Size =
        Vector2.new(

            InnerWidth,

            FillHeight
        )

    Data.Fill.Visible =
        FillHeight > 0

    --------------------------------------------------
    -- 20% DIVIDERS
    --------------------------------------------------

    local SectionHeight =
        BarHeight / 5

    for i = 1, 4 do

        local Y =
            BarY
            + (
                SectionHeight
                * i
            )

        local Line =
            Data.Dividers[i]

        Line.From =
            Vector2.new(

                BarX,

                Y
            )

        Line.To =
            Vector2.new(

                BarX
                + ScaledWidth,

                Y
            )

        Line.Visible =
            true
    end
end

--------------------------------------------------
-- DESTROY PLAYER ESP
--------------------------------------------------

local function DestroyESP(Data)

    if not Data then
        return
    end

    SafeRemove(
        Data.NameText
    )

    SafeRemove(
        Data.InfoText
    )

    SafeRemove(
        Data.CombatText
    )

    SafeRemove(
        Data.Outline
    )

    SafeRemove(
        Data.Background
    )

    SafeRemove(
        Data.Fill
    )

    for _, Line
        in ipairs(
            Data.Dividers
        )
    do
        SafeRemove(Line)
    end

    for _, Line
        in ipairs(
            Data.BoxLines
        )
    do
        SafeRemove(Line)
    end
end

--------------------------------------------------
-- CLEANUP OLD PLAYERS
--------------------------------------------------

local function Cleanup()

    local ok, Characters =
        pcall(function()
            return Live:GetChildren()
        end)

    if not ok
        or not Characters
    then
        return
    end

    local Existing = {}

    for _, Character
        in ipairs(Characters)
    do
        Existing[Character] =
            true
    end

    local Remove = {}

    for Character
        in pairs(ESP)
    do

        if not Existing[Character] then

            table.insert(
                Remove,
                Character
            )
        end
    end

    for _, Character
        in ipairs(Remove)
    do

        DestroyESP(
            ESP[Character]
        )

        ESP[Character] =
            nil
    end
end

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

print(
    "[ESP] Goop ESP started"
)

print(
    "[ESP] RightShift = hide/show menu"
)

while true do

    task.wait(0.03)

    local ok, Characters =
        pcall(function()
            return Live:GetChildren()
        end)

    if ok
        and Characters
    then

        for _, Character
            in ipairs(Characters)
        do

            if IsValidTarget(
                Character
            ) then

                local UpdateOK,
                    UpdateError =
                    pcall(function()

                        UpdateESP(
                            Character
                        )
                    end)

                if not UpdateOK then

                    warn(
                        "[ESP] Update failed:",
                        Character.Name,
                        UpdateError
                    )
                end
            end
        end
    end

    pcall(Cleanup)
end
